# ============================================================
# flame-mcp — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# .env is git-ignored and never committed.
# ============================================================
# flame-mcp uses config.json for most settings (model, backend, RAG).
# See config.example.json for those options.
# ── Anthropic API (required if backend=anthropic) ────────────
# ANTHROPIC_API_KEY=sk-ant-...
# ── Ollama (required if backend=ollama) ──────────────────────
# OLLAMA_URL=http://localhost:11434
